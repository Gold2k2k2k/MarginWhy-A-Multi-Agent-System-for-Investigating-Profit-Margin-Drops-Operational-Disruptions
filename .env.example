# ==============================================================================
# Open Agent Hackathon 2026 — MarginWhy Environment Configuration Template
# Team: Light of Numbers | Track 02: The Agent That Can Explain Why
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env and fill in values.
# ==============================================================================

# Mode Configuration
SAMPLE_MODE=true

# Zetaris AI Data Harness Configuration
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your_zetaris_api_key_here
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMEOUT_SEC=30

# Meterless Nightshift & NVIDIA Nemotron Configuration
METERLESS_BASE_URL=http://localhost:11434/v1
METERLESS_API_KEY=your_meterless_api_key_here
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
